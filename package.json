{
  "name": "gst-india-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for India GST via the Sandbox (Quicko) API: GSTIN verification, PAN search, return tracking, taxpayer OTP sessions, GSTR-2B/3B, and ledgers.",
  "type": "module",
  "license": "MIT",
  "author": "Bhavy Khatri <bhavykhatri@gmail.com>",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gst",
    "gstin",
    "india",
    "tax",
    "tax-compliance",
    "gstr",
    "e-invoice",
    "hsn",
    "sandbox",
    "quicko",
    "ecommerce"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhavykhatri/gst-india-mcp.git"
  },
  "homepage": "https://github.com/bhavykhatri/gst-india-mcp#readme",
  "bugs": {
    "url": "https://github.com/bhavykhatri/gst-india-mcp/issues"
  },
  "bin": {
    "gst-india-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
