# Sandbox (Quicko) GST API credentials — https://console.sandbox.co.in (Settings -> API Keys)
# Test keys are prefixed key_test.../secret_test...; live keys key_live.../secret_live...
GST_API_KEY=key_test_xxxxxxxxxxxxxxxxxxxx
GST_API_SECRET=secret_test_xxxxxxxxxxxxxxxxxxxx

# API base URL and version (defaults shown). Both test and live keys use api.sandbox.co.in.
GST_BASE_URL=https://api.sandbox.co.in
GST_API_VERSION=1.0

# Taxpayer (OTP) session defaults — used by the taxpayer_* tools.
# Requires "Manage API Access" enabled on gst.gov.in for this GSTIN.
GST_USERNAME=your_gst_portal_username
GST_GSTIN=your_15_char_gstin

# Optional: a pre-obtained taxpayer access token (valid ~6h) to skip the OTP flow.
GST_TAXPAYER_TOKEN=
