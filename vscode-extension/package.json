{
  "name": "gst-india-mcp-vscode",
  "displayName": "GST India MCP",
  "description": "Adds the India GST (Sandbox/Quicko) MCP server to VS Code, with secure credential storage. Wraps the gst-india-mcp npm package.",
  "version": "0.1.0",
  "publisher": "bhavykhatri",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": ["AI", "Chat", "Other"],
  "keywords": ["mcp", "model-context-protocol", "gst", "gstin", "india", "tax"],
  "repository": {
    "type": "git",
    "url": "https://github.com/bhavykhatri/gst-india-mcp.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "mcpServerDefinitionProviders": [
      { "id": "gst-india-mcp", "label": "GST India MCP" }
    ],
    "commands": [
      { "command": "gstMcp.setCredentials", "title": "GST India MCP: Set Credentials" },
      { "command": "gstMcp.clearCredentials", "title": "GST India MCP: Clear Credentials" }
    ],
    "configuration": {
      "title": "GST India MCP",
      "properties": {
        "gstMcp.username": {
          "type": "string",
          "default": "",
          "markdownDescription": "GST portal username (for taxpayer tools)."
        },
        "gstMcp.gstin": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your 15-character GSTIN (for taxpayer tools)."
        },
        "gstMcp.baseUrl": {
          "type": "string",
          "default": "https://api.sandbox.co.in",
          "markdownDescription": "Sandbox API base URL."
        },
        "gstMcp.apiVersion": {
          "type": "string",
          "default": "1.0",
          "markdownDescription": "Sandbox API version."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
